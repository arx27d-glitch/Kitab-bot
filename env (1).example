# ===== Telegram API (https://my.telegram.org se) =====
API_ID=1234567
API_HASH=your_api_hash_here

# ===== Bot token (@BotFather se) =====
BOT_TOKEN=123456:ABC-your-bot-token

# ===== Files wala private channel (bot ko is channel me ADMIN banao) =====
# Channel id -100 se shuru hota hai
DB_CHANNEL=-1001234567890

# ===== Auto-forward: in group(s) ke naye messages DB_CHANNEL me apne aap copy honge =====
# Group id -100 se shuru hota hai. Ek se zyada ho to space se alag karo.
# Bot ko group me add karo (admin banao ya BotFather me /setprivacy -> Disable karo).
SOURCE_GROUPS=-1001111111111 -1002222222222
# true karoge to files ke saath text messages bhi forward honge (default: sirf files)
FORWARD_ALL=false

# ===== Admin user ids (space se alag karo) =====
ADMINS=123456789 987654321

# ===== 4 Force-Join Channels =====
# Public channel: @username likho. Private channel: numeric id likho + _LINK me invite link.
# Bot ko in sabhi channels me ADMIN banana zaroori hai, warna join check nahi hoga.
CHANNEL_1=@channel_one
CHANNEL_2=@channel_two
CHANNEL_3=@channel_three
CHANNEL_4=@channel_four
# Private channel ho to ye bhi bharo (warna khali chhod do):
# CHANNEL_4=-1009876543210
# CHANNEL_4_LINK=https://t.me/+AbCdEfGhIjK

# ===== Auto delete (seconds me). 300 = 5 minute, 0 = band =====
AUTO_DELETE_SECONDS=300

# ===== Buttons / names (sab optional) =====
BOT_NAME=Kitab Bot
OWNER_USERNAME=your_username
SUPPORT_USERNAME=your_support_group_or_username
UPDATES_CHANNEL=your_updates_channel

# ===== Optional text change (\n se nayi line) =====
# START_TEXT=Namaste {mention}!\nKitab ka naam bhejo.
# JOIN_TEXT=Pehle saare channels join karo.

# ===== Optional =====
RESULTS_PER_PAGE=8
DB_PATH=files.db
